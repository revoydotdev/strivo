# strivo config reference — ~/.config/strivo/config.toml
#
# Everything in this file is optional. Strivo loads with sensible defaults
# and the first-run wizard writes the minimum required keys for you. Use
# this file as documentation: copy any block into your real config.toml to
# override a default, or leave the block omitted to keep the default.
#
# Path discovery follows XDG. To see the resolved path on your system:
#
#   strivo config path
#
# After editing, validate with:
#
#   strivo config list

# ─── Top-level recording behaviour ────────────────────────────────────────

# Where finished recordings land. ${HOME} and ~ are expanded.
# recording_dir = "~/Videos/strivo"

# How often the monitor polls each platform for live status, in seconds.
# Lower values catch streams sooner at the cost of more API requests.
# poll_interval_secs = 60

# ─── Per-platform credentials ─────────────────────────────────────────────
# All client IDs / secrets are stored in the OS keyring by default; the
# fields below are read at startup if present and migrated into the keyring.
# Prefer the first-run wizard or `strivo config set` over checking secrets
# into this file.

# [twitch]
# client_id     = "..."
# client_secret = "..."

# [youtube]
# client_id     = "..."
# client_secret = "..."
# # Path to a Netscape-format cookies.txt export, used for members-only and
# # age-restricted streams. Leave unset to disable cookie-based auth.
# cookies_path  = "/path/to/cookies.txt"
# # Public HTTPS URL of the WebSub (PubSubHubbub) callback served by
# # `strivo serve` at /yt-websub (e.g. a `tailscale funnel` path). When set,
# # the daemon subscribes each followed channel's upload feed to Google's hub
# # so a new video / live broadcast triggers an immediate poll instead of
# # waiting for the next poll_interval_secs. Unset = polling only.
# websub_callback_url = "https://example.com/yt-websub"

# [patreon]
# # Patreon uses cookie-based auth via the membership API. Path to a
# # Netscape-format cookies.txt export from a logged-in browser session.
# cookies_path  = "/path/to/patreon-cookies.txt"

# ─── Recording pipeline ───────────────────────────────────────────────────

# [recording]
# # Re-encode the recorded stream rather than copying the source bitstream.
# # Off by default — copying is faster, lossless, and the codec is usually
# # fine straight from the platform.
# transcode = false
#
# # Filename template. Available placeholders:
# #   {channel}  — sanitised channel name
# #   {date}     — local date, YYYY-MM-DD
# #   {time}     — local time, HHMMSS
# #   {title}    — sanitised stream title (truncated to 80 chars)
# #   {platform} — twitch / youtube / patreon
# filename_template = "{channel}_{date}_{title}.mkv"
#
# # On Twitch recordings, post-process the finished file to drop black
# # segments left behind when streamlink suppresses ad breaks. Off by default.
# auto_trim_ads = false
#
# # Minimum contiguous black duration (seconds) to consider an ad break when
# # auto_trim_ads is on. Shorter blackouts (fades, transitions) are preserved.
# ad_min_secs = 8.0
#
# # After a Twitch live recording ends, query the helix /videos endpoint for
# # the just-finalized archive VOD and download it alongside the live
# # capture, saved to <base>_vod.<ext>. On by default: the live HLS pull
# # misses the first ~5 minutes plus any ad-break gaps, the VOD has the full
# # broadcast.
# auto_vod_backfill = true
#
# # Seconds to wait after the live ends before polling for the VOD — Twitch
# # takes a few minutes to finalize the archive.
# vod_backfill_delay_secs = 300
#
# # For Twitch + from_start recordings, attempt the live-from-start (Rewind)
# # Usher path before falling back to the standard streamlink live-edge pull.
# # On by default; lands at broadcast t=0 instead of the ~5min HLS DVR window
# # when the streamer has "Always publish VODs" enabled.
# twitch_live_from_start = true
#
# # Default format/bitrate selection, overridable per channel (see
# # auto_record_channels.format) or per capture_profiles entry. All fields
# # optional; unset falls back to the built-in default: format = "bv*+ba/b",
# # copy-mux into an mkv container.
# [recording.format]
# # yt-dlp -f selector. A bare "best" only matches a pre-merged single-file
# # format, which many videos never expose — bv*+ba/b (best video + best
# # audio, falling back to best) is the safe default.
# format = "bv*+ba/b"
# # Target video bitrate in kbps for transcode paths. Ignored when codec is "copy".
# bitrate_kbps = 6000
# # "mkv" (default — crash-resilient) or "mp4".
# container = "mkv"
# # "copy" (default), "h264_nvenc", "libx264", …
# video_codec = "copy"
# # "copy" (default), "aac", …
# audio_codec = "copy"

# ─── Auto-record channels ─────────────────────────────────────────────────
# Each [[auto_record_channels]] block records that channel whenever it goes
# live. Toggle these from the web UI; edits there round-trip through this
# file.
#
# [[auto_record_channels]]
# platform     = "twitch"
# channel_id   = "12345"
# channel_name = "streamer_name"
# # Per-channel format/bitrate override (same shape as [recording.format]).
# # Falls back to the global [recording.format] when absent.
# # format = { container = "mp4" }
# # Name of a [[capture_profiles]] entry to apply to this channel instead.
# # profile = "1080p60+transcript"

# ─── Auto-download uploads (Twitch/YouTube) ────────────────────────────────
# Each [[auto_download_uploads]] block auto-downloads that channel's new
# uploads (not its own live-capture VODs — see auto_record_channels above)
# as the monitor discovers them, at most every 15 minutes. Toggle from the
# rail's right-click "Automatic downloads → Uploads" menu item; edits there
# round-trip through this file. Patreon has no entry here — see
# auto_pull_creators below, which the same rail toggle writes for a Patreon
# creator.
#
# [[auto_download_uploads]]
# platform     = "twitch"
# channel_id   = "12345"
# channel_name = "streamer_name"

# ─── Capture profiles ──────────────────────────────────────────────────────
# Named, reusable capture presets — define recording settings once and
# attach them to many channels via auto_record_channels.profile.
#
# [[capture_profiles]]
# name = "1080p60+transcript"
# # Named quality tier: "best", "1080p", "720p", "480p", or "audio_only".
# # Maps to a yt-dlp/streamlink format selector. When set, wins over the
# # global recording.format unless this profile's own `format` is also set.
# quality_tier = "1080p"
# # Per-profile format/bitrate override (same shape as [recording.format]).
# # format = { container = "mkv" }
# # Transcode captures using this profile (overrides the global default).
# transcode = false
# # Capture audio only (no video track).
# audio_only = false
# # Request a transcript for captures using this profile.
# transcript = false
# # Stop auto-capturing a channel using this profile once this many episodes
# # have been recorded. Omit for no cutoff (capture indefinitely).
# cutoff_episodes = 50

# ─── Channel alert overrides ───────────────────────────────────────────────
# Per-channel override of the global [notifications] on_go_live /
# on_recording_finished switches. channel_key is "platform:channel_id"
# (e.g. "twitch:12345"). Omitting a field follows the global default;
# only an explicit `false` suppresses that alert for this channel.
#
# [[channel_alerts]]
# channel_key = "twitch:12345"
# on_live      = true
# on_upload    = false

# ─── Patreon auto-pull creators ────────────────────────────────────────────
# Patreon creators whose new video posts should be auto-downloaded when the
# monitor sees them. Empty by default — opt in per creator (sidebar toggle
# in the web UI, or add an entry here); the monitor only refreshes the post
# cache for unlisted creators. Identified by campaign_id rather than name
# since creators can rename themselves; creator_name is kept for display.
#
# [[auto_pull_creators]]
# campaign_id  = "1234567"
# creator_name = "creator_display_name"

# ─── Cron schedules ───────────────────────────────────────────────────────
# Force-record a channel on a recurring schedule regardless of live status,
# e.g. to grab a known-time broadcast on a flaky API.
#
# [[schedule]]
# platform   = "twitch"
# channel_id = "12345"
# cron       = "0 20 * * 1-5"   # weekdays at 8 pm local time

# ─── Capture-time safety limits ────────────────────────────────────────────
# Surfaced on the Monitor page. Both fields default to 0 (disabled) so
# existing setups see no behaviour change without explicit opt-in.
#
# [monitor_limits]
# # Maximum number of recordings (live + VOD pull combined) to run
# # concurrently. New live broadcasts beyond this limit are surfaced but not
# # started until a slot opens. 0 = unlimited.
# max_concurrent_recordings = 0
# # Reserved disk space in GB. New captures are deferred once free space on
# # the recording filesystem drops below this watermark. 0 = no circuit
# # breaker.
# disk_budget_reserved_gb = 0

# ─── Desktop / webhook notifications ───────────────────────────────────────
# What state changes the daemon fires a notify-rust desktop banner (and
# optionally an outbound webhook) for. Defaults err on the side of
# useful-but-not-noisy.
#
# [notifications]
# # Master switch. When false the daemon skips every notification.
# desktop_enabled = true
# # Banner when a tracked channel transitions offline → live.
# on_go_live = true
# # Banner when a recording finishes successfully.
# on_recording_finished = true
# # Banner when a recording dies mid-capture. Default-on: silent failures
# # are the worst class of bug in a PVR.
# on_recording_failed = true
# # Banner when the Twitch auto-VOD-backfill pull lands. Off by default —
# # most users don't track it manually.
# on_vod_ready = false
#
# # Outbound webhook — POST a JSON payload for each notification-worthy
# # event (mirrors streamerREC's webhook contract, so existing Make/n8n/
# # Zapier integrations work unmodified). Failures are logged and swallowed.
# [notifications.webhook]
# enabled = false
# url = "https://example.com/webhook"

# ─── Web UI (`strivo serve`) ───────────────────────────────────────────────
# Generated lazily on first `serve` invocation and persisted so values
# survive restarts. Leave unset to have strivo generate and save them for
# you. (The bind address is a `strivo serve --bind` CLI flag, not a config
# field — default 127.0.0.1:8181.)
#
# [web]
# # API key required on the X-Api-Key header for /api/v1/*.
# api_key = "..."
# # HMAC secret used to sign browser-session cookies.
# session_secret = "..."

# ─── Per-plugin toggles ────────────────────────────────────────────────────
# Enable/disable individual plugins from Settings → Plugins. A missing
# entry defaults to enabled = true. Keyed by plugin name.
#
# [plugin_toggles.crunchr]
# enabled = true

# ─── Crunchr (transcription + analysis) — Creator Edition only ────────────
# This block is not a core-typed config section: it round-trips through the
# generic `extensions` table (any [plugin-name] table not otherwise known to
# core is preserved as-is) and is only meaningful when the Crunchr plugin is
# compiled in (Creator Edition, see CLAUDE.md "Editions"). Absent from the
# PVR edition entirely. AI transcription with optional LLM analysis.
# Disabled by default — flip `enabled = true` to turn it on.
#
# [crunchr]
# enabled = false
#
# # Transcription backend. Default: voxtral-openrouter.
# #   "voxtral-openrouter" — Voxtral Mini Transcribe via OpenRouter
# #                          ($0.003/min). Needs OPENROUTER_API_KEY.
# #                          No diarization.
# #   "voxtral-api"        — Mistral's direct API ($0.003/min). Needs
# #                          MISTRAL_API_KEY. Supports `diarize = true`.
# #   "whisperx-local"     — self-hosted Whisper large-v3 + pyannote 3.1.
# #                          Free, ~8 GB VRAM via two-stage VRAM unloading.
# #                          Needs `pip install whisperx torch`, HF_TOKEN.
# #                          Supports `diarize = true`.
# #   "voxtral-local"      — self-hosted Voxtral via any OpenAI-compatible
# #                          endpoint (vLLM / RunPod). Free, needs GPU.
# #                          No diarization.
# #   "whisper-cli"        — local Whisper subprocess (pip install openai-whisper).
# #                          No diarization.
# backend = "voxtral-openrouter"
#
# # Env var name to read the transcription API key from. Defaults:
# #   OPENROUTER_API_KEY for voxtral-openrouter
# #   MISTRAL_API_KEY    for voxtral-api
# #   HF_TOKEN           for whisperx-local (pyannote model download license)
# # Override only if your shell uses a different variable name.
# api_key_env = "OPENROUTER_API_KEY"
#
# # Base URL for self-hosted Voxtral. Only used when backend = "voxtral-local".
# endpoint = "http://localhost:8000/v1"
#
# # Whisper CLI model (tiny / base / small / medium / large). Only used when
# # backend = "whisper-cli".
# whisper_model = "base"
#
# # Hard cap on the whisper subprocess in seconds.
# whisper_timeout_secs = 7200
#
# # Request speaker diarization. Only honoured by backends that actually
# # produce speaker labels: `voxtral-api` (Mistral cloud) and `whisperx-local`
# # (self-hosted GPU). When on, finished recordings open the Speaker Editor
# # modal where you can audition each speaker and rename labels in place.
# diarize = false
#
# # After a transcription job finishes, mux the generated `.vtt` subtitles
# # back into the recording's `.mkv` via `mkvmerge` as a soft-sub track.
# # Skipped quietly if `mkvmerge` is not on PATH.
# embed_subs = true
#
# # Tandem auto-trigger: when a recording finishes for one of these channels
# # / playlists, automatically queue it for transcription.
# tandem_channels  = ["Twitch:12345"]
# tandem_playlists = []
#
# [crunchr.analysis]
# enabled                = false
# openrouter_api_key_env = "OPENROUTER_API_KEY"
# model                  = "mistralai/mistral-7b-instruct"

# ─── Theme ────────────────────────────────────────────────────────────────
# Two forms are accepted; pick one.
#
# Form 1 — plain string (legacy, still supported). Any built-in name:
# neon, neon-light, neon-hc, monochrome, tokyo-night, gruvbox-dark,
# rose-pine-moon, nord, dracula, kanagawa, everforest-dark,
# catppuccin-mocha, solarized-dark. Also accepts the basename of any user
# theme in ~/.config/strivo/themes/*.{toml,conf}.
#
# theme = "tokyo-night"
#
# Form 2 — rich table with per-slot overrides layered on top of a base.
# `name` picks the base theme; `[theme.colors]` and `[theme.ansi]` swap
# individual slots. Anything you omit inherits from the base.
#
# [theme]
# name = "tokyo-night"
#
# [theme.colors]
# # Base surfaces and semantic accents:
# #   bg, fg, surface, overlay, primary, secondary, dim, muted
# primary   = "#00E5FF"
# secondary = "#FFB020"
#
# [theme.ansi]
# # ANSI slots: black, red, green, yellow, blue, magenta, cyan, white
# red   = "#FF5555"
# green = "#50FA7B"

# ─── User themes directory ────────────────────────────────────────────────
# Drop theme files into ~/.config/strivo/themes/ — strivo loads them on
# startup. Two formats:
#
#   *.toml   native strivo theme (see any built-in for the shape)
#   *.conf   Kitty / Ghostty keyword format (foreground, background,
#            color0..color15, cursor, selection_foreground,
#            selection_background). Unknown keys are skipped with a
#            warning; missing slots fall back to Neon.

# ─── UI ───────────────────────────────────────────────────────────────────
# Animation and accessibility toggles.
#
# [ui]
# # Snap every tween/pulse/shimmer to its end state. Equivalent to the
# # STRIVO_REDUCE_MOTION=1 environment variable (env wins if both are set).
# reduce_motion  = false
#
# # Reserved for screen-reader-friendly status strings. Not all widgets
# # consume this yet — safe to leave at default.
# verbose_status = false

{
  "name": "strivo-web-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E for the StriVo web UI (W7)",
  "type": "module",
  "scripts": {
    "pretest": "node check-pvr-bundle.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:real": "playwright test -c playwright.real.config.ts",
    "test:performance": "playwright test -c playwright.performance.config.ts",
    "install-browser": "playwright install chromium",
    "check:pvr-bundle": "node check-pvr-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0"
  }
}
